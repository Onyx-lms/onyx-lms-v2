# ---------------------------------------------------------------------------
# Onyx LMS - environment
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Supabase (F-02). Fill these in from your project dashboard. ------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# service_role bypasses RLS. Server-side ONLY. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Settings > API > JWT Secret. We sign our own tokens with this so Postgres
# trusts them (see ADR-001 - we do NOT use Supabase Auth).
SUPABASE_JWT_SECRET=

# --- Auth -------------------------------------------------------------------
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=1209600

# --- Storage (P-04): bucket mirrors the Laravel public/uploads tree ---------
STORAGE_BUCKET=uploads
STORAGE_PUBLIC_BASE=

# --- Optional infra (see README "Dependency policy"). Leave blank to skip. --
REDIS_URL=
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Onyx Code Lab (O03)
# ---------------------------------------------------------------------------
# The sandbox that runs learner code. With this unset, Code Lab works except
# for running code, which answers 503 -- there is deliberately no local
# fallback, because running untrusted code in the API process is not a thing
# to do "just in development".
ONYX_JUDGE0_URL=
ONYX_JUDGE0_TOKEN=

# The in-process Code Lab worker. Set the interval to 0 to run the worker
# somewhere else instead; the queue is durable either way.
ONYX_WORKER_INTERVAL_MS=2000
ONYX_WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Where a payment gateway sends a payer back to. It goes into the success and
# cancel URLs handed to the provider, so it has to be the address the browser
# actually reaches this deployment at -- not localhost, on anything deployed.
# Unset, it falls back to http://127.0.0.1:5173, which is right in development
# and, in production, is a payer returning to a page on their own machine.
#
# No trailing slash. Gateway credentials are NOT here: they are per-tenant and
# live in onyx_payment_gateways, configured in Settings -> Payments.
WEB_URL=http://127.0.0.1:5173
