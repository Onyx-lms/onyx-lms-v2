# Dependencies
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Secrets. .env holds real Supabase keys -- never commit it.
.env
.env.*
!.env.example

# Local runtime noise
*.log
npm-debug.log*
coverage/
.turbo/

# OS
.DS_Store
Thumbs.db

# Claude Code: the shared config is committed, per-developer overrides are not.
.claude/settings.local.json

# Supabase CLI scratch — holds the linked project ref
supabase/.temp/

# Playwright run artifacts (screenshots, traces) -- never meant to be committed.
test-results/
playwright-report/
.vercel
.env*
# ...except the one that is deliberately all placeholders. It is the only
# record of what a deployment needs set, and ignoring it meant a new variable
# could be read by the code and documented nowhere anybody would look.
!.env.example

# Generated credential exports hold plaintext passwords for real seeded
# accounts -- never commit one of these, wherever it ends up.
*Credentials*.xlsx
*credentials*.csv

# Throwaway files from verification runs. Named so they cannot be mistaken for
# source -- and ignored because one of them briefly held an auth token and was
# staged by a `git add -A`, which is the kind of thing that only has to happen
# once.
_scratch*
_s_*

# Razorpay test credentials handed over by the client. Never committed:
# a key in a repository is a key on every laptop that clones it.
rzp*.csv

# QA screenshots, written by the qa-*.mjs drivers on every run.
qa-*.png

# Per-tenant JSON dumps taken before an institution is deleted. They are the
# only copy of that institution's data and belong on the operator's disk, not
# in a repository that gets cloned.
backups/

# Ad-hoc probe scripts. Scratch by nature -- named x1..x17, stu1..stu12 --
# and swept into a commit once by `git add -A`. Kept out of the history
# rather than tidied into it: they are somebody working, not a suite.
qa-run/
